                "name": "propertyId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for a property."
              },
              {
                "name": "filter[name]",
                "value": "example_value",
                "type": "query"
              },
              {
                "name": "filter[enabled]",
                "value": "true",
                "type": "query"
              },
              {
                "name": "page[number]",
