              {
                "name": "secretId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for a secret."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Test, retry, or reauthorize a secret. Use meta.action to specify the operation: test (trigger exchange), retry (re-exchange after failure), or reauthorize (for oauth2-google secrets)."
        },
        {
          "info": {
            "name": "Delete a Secret",
            "type": "http"
