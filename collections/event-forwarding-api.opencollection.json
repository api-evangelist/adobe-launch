{
  "opencollection": "1.0.0",
  "info": {
    "name": "Adobe Experience Platform Event Forwarding API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
